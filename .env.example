# Get a key at https://featherless.ai  ->  Account -> API Keys
FEATHERLESS_API_KEY=your_key_here

# Base URL (OpenAI-compatible). Change only if Featherless moves it.
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1

# Model roster. Every one of these is overridable without touching code,
# because model availability on Featherless changes. Run `npm run health`
# to confirm which of these actually respond before you demo.
# NOTE: meta-llama/* models are GATED on Featherless - they return HTTP 403
# unless your account has a linked HuggingFace licence. Avoid them, or run
# `npm run models` to auto-discover ids your key can actually call.
MODEL_TRIAGE=Qwen/Qwen3-8B
MODEL_TRIAGE_FALLBACK=google/gemma-4-E4B-it
MODEL_REASON=deepseek-ai/DeepSeek-V4-Flash
MODEL_REASON_FALLBACK=Qwen/Qwen3.8-27B
MODEL_DEFEND=zai-org/GLM-5.3
MODEL_DEFEND_FALLBACK=google/gemma-4-31B-it

# Confidence below this escalates to "VERIFY FIRST" instead of a hard verdict.
CONFIDENCE_THRESHOLD=0.60

# Per-model-call timeout. Keep the total under your host's function limit
# (Vercel Hobby = 60s) across up to 3 model calls.
MODEL_TIMEOUT_MS=20000
# Timeout for a single RDAP / link-expansion lookup.
EVIDENCE_TIMEOUT_MS=5000

# Many open-weight models (Qwen3 especially) emit a <think> block before the
# answer, which breaks JSON parsing and can consume the whole token budget.
# "true" appends the /no_think soft switch to the user turn. Set to false only
# if your chosen models do not recognise it.
DISABLE_THINKING=true
